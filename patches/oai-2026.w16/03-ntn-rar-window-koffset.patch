# Patch: make the Msg2/RAR response window NTN-aware (add K_offset)
# Target: OpenAirInterface tag 2026.w16 (commit 38dc378224)
# File:   openair2/LAYER2/NR_MAC_gNB/gNB_scheduler_RA.c
#         (msg2_in_response_window and its call site)
#
# Problem: Under GEO NTN, the gNB correctly detects the PRACH preamble and
# generates the Msg2/RAR, but the RA then fails. The RAR response-window check
# (msg2_in_response_window) uses the base ra-ResponseWindow, which OAI caps at
# sl80 (80 slots / 80 ms). A GEO round trip is ~477 ms (~478 slots), so the
# window expires long before the UE can receive the RAR. The UE times out,
# retries with a new preamble, and the RAR for the old preamble is discarded as
# a RAPID mismatch (e.g. "Received RAR preamble (15) doesn't match intended
# RAPID (19)"), looping forever on "RAR reception failed".
#
# Root cause: the Msg3/K2 scheduling path already adds get_NTN_Koffset(scc) for
# NTN (see K2 = tda_info.k2 + get_NTN_Koffset(scc)), but the RAR response-window
# check was never made NTN-aware.
#
# Fix: extend the effective response window by the cell-specific NTN K_offset
# (already SCS-scaled by get_NTN_Koffset), mirroring the Msg3 path. For
# terrestrial, get_NTN_Koffset() returns 0, so behaviour is byte-for-byte
# unchanged. The "<=10ms" warning is suppressed when a non-zero NTN koffset is
# in use, since the large window is intentional there.
#
# Effect: gNB keeps the RA context alive across the GEO round trip, so the UE's
# RAR reception aligns with the preamble it actually sent, allowing RACH to
# progress past Msg2 toward Msg3/contention resolution.
# Apply from the OAI repo root:  git apply <this file>
#
--- a/openair2/LAYER2/NR_MAC_gNB/gNB_scheduler_RA.c
+++ b/openair2/LAYER2/NR_MAC_gNB/gNB_scheduler_RA.c
@@ -1346,10 +1346,19 @@
                                     int n_slots_frame,
                                     long rrc_ra_ResponseWindow,
                                     int current_frame,
-                                    int current_slot)
+                                    int current_slot,
+                                    int ntn_koffset)
 {
   int window_slots = get_response_window(rrc_ra_ResponseWindow);
-  if (window_slots > n_slots_frame)
+  // For NTN, the Msg2/RAR exchange is shifted by the cell-specific K_offset to
+  // account for the long propagation delay (e.g. ~478 slots for GEO). The base
+  // ra-ResponseWindow (max sl80) cannot cover a GEO round trip, so without this
+  // the gNB abandons the RA before the UE can receive the RAR. We extend the
+  // effective window by the NTN K_offset, mirroring how the Msg3/K2 path already
+  // adds get_NTN_Koffset(). For terrestrial, ntn_koffset == 0 and behaviour is
+  // unchanged.
+  window_slots += ntn_koffset;
+  if (window_slots > n_slots_frame && ntn_koffset == 0)
     LOG_E(NR_MAC, "RA-ResponseWindow need to be configured to a value lower than or equal to 10 ms\n");
   int abs_rach = n_slots_frame * rach_frame + rach_slot;
   int abs_now = n_slots_frame * current_frame + current_slot;
@@ -1521,7 +1530,7 @@
   long rrc_ra_ResponseWindow =
       scc->uplinkConfigCommon->initialUplinkBWP->rach_ConfigCommon->choice.setup->rach_ConfigGeneric.ra_ResponseWindow;
   const int n_slots_frame = nr_mac->frame_structure.numb_slots_frame;
-  if (!msg2_in_response_window(ra->preamble_frame, ra->preamble_slot, n_slots_frame, rrc_ra_ResponseWindow, frameP, slotP)) {
+  if (!msg2_in_response_window(ra->preamble_frame, ra->preamble_slot, n_slots_frame, rrc_ra_ResponseWindow, frameP, slotP, get_NTN_Koffset(scc))) {
     LOG_E(NR_MAC,
           "sfn: %d.%d UE RA-RNTI %04x TC-RNTI %04x: exceeded RA window, cannot schedule Msg2\n",
           frameP,
