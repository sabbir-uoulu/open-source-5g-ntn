# Patch: enlarge RFsimulator writer queue for NTN timing advance
# Target: OpenAirInterface tag 2026.w16 (commit 38dc378224)
# File:   radio/COMMON/common_lib.h  (WRITE_QUEUE_SZ)
#
# Problem: The NTN UE applies a timing advance of ~3.6M samples for GEO
# (the full 477 ms round trip). This enqueues far more pending write
# buffers than the stock fixed queue of 20, overflowing it and tripping
# an assertion (i < 20) in writerEnqueue(), crashing the UE.
#
# Fix: Raise WRITE_QUEUE_SZ from 20 to 1000 to hold the buffered samples
# spanning the GEO round-trip delay.
#
# Effect: UE no longer crashes during NTN RACH (terrestrial unaffected).
# Apply from the OAI repo root:  git apply <this file>
#
diff --git a/radio/COMMON/common_lib.h b/radio/COMMON/common_lib.h
index 72b24ca13e..8526932099 100644
--- a/radio/COMMON/common_lib.h
+++ b/radio/COMMON/common_lib.h
@@ -332,7 +332,7 @@ typedef struct fhstate_s {
   int active;
 } fhstate_t;
 
-#define WRITE_QUEUE_SZ 20
+#define WRITE_QUEUE_SZ 1000
 typedef struct {
   bool initDone;
   pthread_mutex_t mutex_write;
